# Connection string dari Neon (Dashboard > Connection Details)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Kata sandi login admin (min. 12 karakter)
ADMIN_PASSWORD=ganti-dengan-sandi-kuat
# String acak panjang untuk menandatangani sesi admin (contoh: openssl rand -hex 32)
ADMIN_SECRET=ganti-dengan-string-acak-panjang
